BASE_URL=http://localhost:3000
# Platform operator login email (enables /admin)
ADMIN_EMAIL=
# Optional: real AI agent + AI onboarding (otherwise a rule-based fallback is used)
ANTHROPIC_API_KEY=
# WhatsApp webhook: verify token and (in production, REQUIRED) the Meta app secret for signature checks
WA_VERIFY_TOKEN=devagent-verify
WA_APP_SECRET=
# Platform-wide WhatsApp credentials (optional; tenants can store their own in Connect)
WA_TOKEN=
WA_PHONE_ID=
# Call Rescue webhook shared secret
RESCUE_WEBHOOK_SECRET=
# Local testing only: lets you switch plans/credits without payment
DEV_BILLING=0
