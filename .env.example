# Copy to .env.local (npm run dev) or .env (docker compose) and edit.

PORT=3100
BASE_URL=http://localhost:3100

# Postgres holds all the data. "docker compose up -d db" starts one (port 5440 on this machine).
DATABASE_URL=postgres://devagent:devagent@localhost:5440/devagent
POSTGRES_PASSWORD=devagent
DB_PORT=5440
DB_POOL_MAX=10
LOG_LEVEL=info

# Platform operator login email (enables /admin)
ADMIN_EMAIL=

# Optional: real AI agent + AI onboarding (otherwise a rule-based fallback is used)
ANTHROPIC_API_KEY=

# WhatsApp webhook: verify token and (in production, REQUIRED) the Meta app secret for signature checks
WA_VERIFY_TOKEN=devagent-verify
WA_APP_SECRET=
# Platform-wide WhatsApp credentials (optional; each business can store its own in Connect)
WA_TOKEN=
WA_PHONE_ID=

# Call Rescue webhook shared secret
RESCUE_WEBHOOK_SECRET=

# Protect /api/metrics with "Authorization: Bearer <token>" (leave empty for local demos)
METRICS_TOKEN=

# Grafana admin password (docker compose --profile monitoring)
GRAFANA_PASSWORD=admin

# Local testing only: lets you switch plans/credits without payment
DEV_BILLING=0
